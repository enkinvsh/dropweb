<?xml version="1.0" encoding="utf-8"?>
<!--
    The unliked heart in the media notification.

    Drawn as a stroked contour rather than as a filled outline ring, the same
    way ic_power.xml is: the system renders notification action icons small and
    monochrome, and a single 2dp contour survives that scale where a hairline
    ring does not. White is the convention here — Android tints the action icon
    itself, so the literal only has to be opaque.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M20.84,4.61 a5.5,5.5 0 0,0 -7.78,0 L12,5.67 L10.94,4.61 a5.5,5.5 0 0,0 -7.78,7.78 L4.22,13.45 L12,21.23 L19.78,13.45 L20.84,12.39 a5.5,5.5 0 0,0 0,-7.78 z"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
