<?xml version="1.0" encoding="utf-8"?>
<!-- Нажатие на кнопку. Нейтральный серый с прозрачностью читается и на светлой, и на
     тёмной плашке; цвет форм в RemoteViews не знаем заранее. Маска овальная: ripple
     не умеет cookie, но круг вписан в неё без выступов. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40808080">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
